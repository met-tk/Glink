<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Glink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glink" Title="Glink">
    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}" AllowDrop="True" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- A continuous native drag surface, with the caption buttons reserved by Windows. -->
        <Grid x:Name="TitleBarRegion" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}">
            <TextBlock Text="Glink" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        </Grid>

        <Grid x:Name="SidebarRegion" Grid.Row="1" Background="{StaticResource SidebarBrush}" Padding="12,0,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="你的灵感，随光沉淀" Style="{StaticResource AppSubTitleStyle}" Margin="12,14,12,28" />
            <StackPanel Grid.Row="1" Margin="0,0,0,16" Spacing="4">
            <Grid>
                <Border x:Name="AllHighlight" Background="{StaticResource SelectionBrush}" CornerRadius="8" />
                <Button x:Name="AllButton" Style="{StaticResource SidebarTextStyle}" HorizontalContentAlignment="Stretch" Click="AllButton_Click" AutomationProperties.Name="全部灵感">
                    <Grid ColumnSpacing="10" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="全部灵感" Style="{StaticResource CategoryNameStyle}" />
                        <TextBlock Grid.Column="2" x:Name="AllCountText" Text="0" Style="{StaticResource CountStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
            <Grid>
                <Border x:Name="FavoritesHighlight" Background="{StaticResource SelectionBrush}" CornerRadius="8" Visibility="Collapsed" />
                <Button x:Name="FavoritesButton" Style="{StaticResource SidebarTextStyle}" HorizontalContentAlignment="Stretch" Click="FavoritesButton_Click" AutomationProperties.Name="收藏" ToolTipService.ToolTip="收藏 (Ctrl + 2)">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE735;" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="收藏" Style="{StaticResource CategoryNameStyle}" />
                        <TextBlock Grid.Column="2" x:Name="FavoritesCountText" Text="0" Style="{StaticResource CountStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="情绪意向" Style="{StaticResource SidebarLabelStyle}" Margin="12,8,12,10" />
                <!-- 分类行由代码构建（MainWindow.Categories.cs）：支持集合文件夹、
                     缩进、折叠展开与拖拽排序；行距固定 48 供 FLIP 动画按索引换算。 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="CategoryListHost" />
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="3" Spacing="4">
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="12,12,12,12" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="NewCategoryButton" Style="{StaticResource SidebarTextStyle}" Click="NewCategoryButton_Click" AutomationProperties.Name="新建分类">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE710;" FontSize="15" /><TextBlock Text="新建分类" /></StackPanel>
                    </Button>
                    <Button x:Name="NewFolderButton" Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Click="NewFolderButton_Click"
                            AutomationProperties.Name="新建分类集合" ToolTipService.ToolTip="新建分类集合，右键分类可移入">
                        <FontIcon Glyph="&#xE8F4;" FontSize="15" />
                    </Button>
                </Grid>
                <Button x:Name="ExportButton" Style="{StaticResource SidebarTextStyle}" Click="ExportButton_Click" AutomationProperties.Name="导出灵感">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEDE1;" FontSize="16" /><TextBlock Text="导出灵感" /></StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource SidebarTextStyle}" Click="SettingsButton_Click" AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="设置" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentArea" Grid.Row="1" Grid.Column="1" Background="{StaticResource CanvasGlowBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="ContentHeader" Padding="32,20,32,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Ellipse x:Name="TitleDot" Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContentTitle" Text="全部灵感" Style="{StaticResource ContentTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ContentSubtitle" Text="0 个灵感" Style="{StaticResource ContentSubTitleStyle}" Margin="21,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="AddInspirationBtn" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="AddInspirationBtn_Click" AutomationProperties.Name="添加灵感">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="添加灵感" /></StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="200" Spacing="4">
                                <Button Style="{StaticResource SidebarTextStyle}" Click="AddText_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8AC;" FontSize="15" /><TextBlock Text="写一段文字" /></StackPanel></Button>
                                <Button Style="{StaticResource SidebarTextStyle}" Click="AddFile_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="15" /><TextBlock Text="选择文件" /></StackPanel></Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Grid x:Name="FilterRow" Grid.Row="1" Margin="32,24,32,20" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="TypeFilters" Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="ChipAllType" Style="{StaticResource FilterChipStyle}" Content="全部" IsChecked="True" Click="TypeChip_Click" Tag="all" />
                    <ToggleButton x:Name="ChipText" Style="{StaticResource FilterChipStyle}" Content="文本" Click="TypeChip_Click" Tag="text" />
                    <ToggleButton x:Name="ChipImage" Style="{StaticResource FilterChipStyle}" Content="图片" Click="TypeChip_Click" Tag="image" />
                    <ToggleButton x:Name="ChipAudio" Style="{StaticResource FilterChipStyle}" Content="音频" Click="TypeChip_Click" Tag="audio" />
                    <ToggleButton x:Name="ChipVideo" Style="{StaticResource FilterChipStyle}" Content="视频" Click="TypeChip_Click" Tag="video" />
                </StackPanel>
                <StackPanel x:Name="TimeFilters" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="ChipAllTime" Style="{StaticResource FilterChipStyle}" Content="全部时间" IsChecked="True" Click="TimeChip_Click" Tag="all" />
                    <ToggleButton x:Name="ChipToday" Style="{StaticResource FilterChipStyle}" Content="今日" Click="TimeChip_Click" Tag="today" />
                    <ToggleButton x:Name="ChipWeek" Style="{StaticResource FilterChipStyle}" Content="近7天" Click="TimeChip_Click" Tag="week" />
                    <ToggleButton x:Name="ChipEarlier" Style="{StaticResource FilterChipStyle}" Content="更早" Click="TimeChip_Click" Tag="earlier" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
<ToggleButton x:Name="ViewTileButton" Style="{StaticResource FilterChipStyle}" Content="平铺" IsChecked="True" Click="ViewModeChip_Click" Tag="tile" AutomationProperties.Name="紧凑平铺视图" />
                    <ToggleButton x:Name="ViewListButton" Style="{StaticResource FilterChipStyle}" Content="列表" Click="ViewModeChip_Click" Tag="list" AutomationProperties.Name="列表视图" />
<ToggleButton x:Name="ViewWordCloudButton" Style="{StaticResource FilterChipStyle}" Content="词云" Click="ViewModeChip_Click" Tag="wordcloud" Visibility="Collapsed" AutomationProperties.Name="词云视图" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="CanvasScroll" Grid.Row="2" Padding="32,4,32,80"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="2.5" ViewChanged="CanvasScroll_ViewChanged"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Top" AllowDrop="True">
                <Grid x:Name="CanvasHost" Width="6000" Height="4000" Background="Transparent">
                    <Canvas x:Name="CardCanvas" Background="Transparent" />
                </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="ListScroll" Grid.Row="2" Visibility="Collapsed"
                          Padding="32,16,32,72" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.6" MaxZoomFactor="1.6"
                          ViewChanged="ListScroll_ViewChanged" SizeChanged="ListScroll_SizeChanged">
                <StackPanel x:Name="ListSections" Spacing="26" />
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{StaticResource AccentBrush}" Opacity="0.7" Margin="0,0,0,8" />
                <TextBlock x:Name="EmptyTitle" Text="留一个位置，给新的灵感" FontSize="20" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyHint" Text="拖入图片、音频或视频，也可以写下一段文字。" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="UndoButton" Style="{StaticResource ToolButtonStyle}" Click="UndoButton_Click" IsEnabled="False" AutomationProperties.Name="撤回"><FontIcon Glyph="&#xE7A7;" FontSize="16" /></Button>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolButtonStyle}" Click="RedoButton_Click" IsEnabled="False" AutomationProperties.Name="重做"><FontIcon Glyph="&#xE7A6;" FontSize="16" /></Button>
                    <Button x:Name="ZoomResetBtn" Style="{StaticResource ToolButtonStyle}" MinWidth="62" Click="ZoomReset_Click"
                            ToolTipService.ToolTip="Ctrl + 滚轮缩放 · 点击恢复 100%" AutomationProperties.Name="缩放 100%，点击恢复原始大小" Content="100%" />
                    <Button x:Name="PackBtn" Style="{StaticResource ToolButtonStyle}" Click="Pack_Click" ToolTipService.ToolTip="紧凑平铺 (Ctrl + Shift + P)" AutomationProperties.Name="紧凑平铺"><FontIcon Glyph="&#xE9A3;" FontSize="16" /></Button>
                    <Button x:Name="SaveLayoutBtn" Style="{StaticResource ToolButtonStyle}" Click="SaveLayout_Click" ToolTipService.ToolTip="保存画布布局为预设，侧栏可随时加载" AutomationProperties.Name="保存画布布局"><FontIcon Glyph="&#xE74E;" FontSize="16" /></Button>
                    <Button x:Name="ImmersiveButton" Style="{StaticResource ToolButtonStyle}" Click="ImmersiveButton_Click" ToolTipService.ToolTip="沉浸模式 (Esc 退出) · F11 全屏" AutomationProperties.Name="沉浸模式"><FontIcon x:Name="ImmersiveIcon" Glyph="&#xE740;" FontSize="16" /></Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings remains in the current workspace; themes preview immediately. -->
        <Border x:Name="SettingsPanel" Grid.Row="1" Grid.Column="1" Canvas.ZIndex="90" Width="420" MaxWidth="500"
                HorizontalAlignment="Right" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed" Padding="28">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button x:Name="CloseSettingsButton" Style="{StaticResource ToolButtonStyle}" HorizontalAlignment="Right" Click="CloseSettings_Click" AutomationProperties.Name="关闭设置" ToolTipService.ToolTip="关闭设置 (Esc)"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="10">
                            <ToggleButton x:Name="ThemePickerToggle" Style="{StaticResource FilterChipStyle}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Padding="12" IsChecked="False" Checked="ThemePickerToggle_Changed" Unchecked="ThemePickerToggle_Changed"
                                          AutomationProperties.Name="展开或收起外观主题">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="外观主题" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="CurrentThemeName" Grid.Column="1" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <FontIcon x:Name="ThemePickerChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SubTextBrush}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel x:Name="ThemeOptions" Spacing="8" Visibility="Collapsed" />
                            <TextBlock x:Name="ThemeSaveStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock Text="画布" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0" />
                        <TextBlock Text="紧凑平铺默认从画布左上角开始排布；开启后以最大的卡片为中心、其余卡片环绕放射式排布在当前可视区域中心。" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                        <StackPanel x:Name="CanvasOptions" Spacing="8" Margin="0,4,0,0" />
                        <TextBlock Text="快捷键" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0" />
                        <TextBlock Text="点击右侧的组合键即可重新录制，可搭配 Ctrl / Shift / Alt。Ctrl + 滚轮缩放、Esc 退出沉浸、F11 全屏为固定操作；按住鼠标中键可自由拖动画布；Shift + 左键拖拽框选卡片，Ctrl + 左键点选增减，多选后右键可批量删除、归类或收藏。" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                        <StackPanel x:Name="ShortcutList" Spacing="2" Margin="0,4,0,0" />
                        <Button x:Name="ResetShortcutsButton" Style="{StaticResource SidebarTextStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetShortcuts_Click" AutomationProperties.Name="恢复默认快捷键">
                            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="恢复默认快捷键" /></StackPanel>
                        </Button>
                        <TextBlock x:Name="ShortcutStatus" Text=" " TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="撤回记录保留最近 100 步，关闭软件后清空。编辑文字时，撤回与重做作用于当前输入框。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel Spacing="4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Glink" FontSize="14" Foreground="{StaticResource TextBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="版本" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                <TextBlock x:Name="VersionText" Text="1.2.0" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <HyperlinkButton x:Name="CreatorLink" Content="AI-driven by taketo"
                                         NavigateUri="https://space.bilibili.com/24340298"
                                         Foreground="{StaticResource AccentBrush}" FontSize="12" Padding="0,4" MinHeight="32"
                                         HorizontalAlignment="Left" ToolTipService.ToolTip="前往 taketo 的哔哩哔哩主页">
                            <HyperlinkButton.Resources>
                                <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="AccentBrush" />
                                <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="AccentBrush" />
                                <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="AccentBrush" />
                            </HyperlinkButton.Resources>
                        </HyperlinkButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DropOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="100" Background="{StaticResource BgBrush}" Opacity="0.96"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="16" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropHint" Text="释放以添加灵感" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    <TextBlock Text="文本、图片、音频、视频 · 支持多文件" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Canvas x:Name="DragLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="200" IsHitTestVisible="False" />
        <InfoBar x:Name="ImportStatus" Grid.Row="1" Grid.Column="1" Canvas.ZIndex="101" Margin="24,24,24,88" MaxWidth="680"
                 VerticalAlignment="Bottom" HorizontalAlignment="Stretch" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
